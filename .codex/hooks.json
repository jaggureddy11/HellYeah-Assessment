{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/bin/python3\" \"/Users/apple/Documents/Hellyeah/interview/.interview/ivkit/hook_log.py\" --tool codex session_start || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/local/bin/python3\" \"/Users/apple/Documents/Hellyeah/interview/.interview/ivkit/hook_log.py\" --tool codex user_prompt || true",
            "timeout": 5
          }
        ]
